<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cb_surface"
    android:orientation="vertical"
    android:padding="24dp">

    <!-- HEADER -->
    <TextView
        android:id="@+id/main_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp"
        android:gravity="center"
        android:text="@string/isMainFragment"
        android:textColor="@color/cb_ink"
        android:textSize="44sp" />

    <!-- GRID WITH WEIGHTS -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <!-- ROW 1 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/main_button_frag_three"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_margin="8dp"
                android:layout_weight="1"
                android:background="@drawable/bg_card_menu"
                android:text="@string/fragmentThree"
                android:textAllCaps="false"
                android:textColor="@color/cb_ink"
                android:textSize="28sp" />
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/main_button_frag_four"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_margin="8dp"
                android:layout_weight="1"
                android:background="@drawable/bg_card_menu"
                android:text="@string/fragmentFour"
                android:textAllCaps="false"
                android:textColor="@color/cb_ink"
                android:textSize="28sp" />
        </LinearLayout>

        <!-- ROW 2 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/main_button_frag_five"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_margin="8dp"
                android:layout_weight="1"
                android:background="@drawable/bg_card_menu"
                android:text="@string/fragmentFive"
                android:textAllCaps="false"
                android:textColor="@color/cb_ink"
                android:textSize="28sp" />
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/main_button_frag_six"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_margin="8dp"
                android:layout_weight="1"
                android:background="@drawable/bg_card_menu"
                android:text="@string/fragmentSix"
                android:textAllCaps="false"
                android:textColor="@color/cb_ink"
                android:textSize="28sp" />
        </LinearLayout>

        <!-- ROW 3 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/main_button_frag_seven"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_margin="8dp"
                android:layout_weight="1"
                android:background="@drawable/bg_card_menu"
                android:text="@string/fragmentSeven"
                android:textAllCaps="false"
                android:textColor="@color/cb_ink"
                android:textSize="28sp" />
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/main_button_frag_eight"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_margin="8dp"
                android:layout_weight="1"
                android:background="@drawable/bg_card_menu"
                android:text="@string/fragmentEight"
                android:textAllCaps="false"
                android:textColor="@color/cb_ink"
                android:textSize="28sp" />
        </LinearLayout>

        <!-- ROW 4 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/main_button_frag_nine"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_margin="8dp"
                android:layout_weight="1"
                android:background="@drawable/bg_card_menu"
                android:text="@string/fragmentNine"
                android:textAllCaps="false"
                android:textColor="@color/cb_ink"
                android:textSize="28sp" />
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/main_button_frag_ten"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_margin="8dp"
                android:layout_weight="1"
                android:background="@drawable/bg_card_menu"
                android:text="@string/fragmentTen"
                android:textAllCaps="false"
                android:textColor="@color/cb_ink"
                android:textSize="28sp" />
        </LinearLayout>

    </LinearLayout>

    <!-- LOGOS AT BOTTOM -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:layout_marginTop="16dp"
        android:gravity="center"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/imageView2"
            android:layout_width="200dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="32dp"
            android:scaleType="centerInside"
            android:src="@drawable/logo_ujep" />

        <ImageView
            android:id="@+id/imageView13"
            android:layout_width="200dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="32dp"
            android:scaleType="centerInside"
            android:src="@drawable/logo_kraj_nove" />

        <ImageView
            android:id="@+id/imageView4"
            android:layout_width="200dp"
            android:layout_height="match_parent"
            android:scaleType="centerInside"
            android:src="@drawable/icuk" />
    </LinearLayout>

</LinearLayout>