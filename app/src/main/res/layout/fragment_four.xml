<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    android:background="@color/cb_canvas" xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="fill_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <TextView
        android:id="@+id/four_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="@string/isFragmentFour"
        android:textColor="@color/cb_ink"
        android:textSize="40sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/four_say"
        android:layout_width="400dp"
        android:layout_height="100dp"
        android:paddingTop="0dp"
        android:paddingBottom="0dp"
        android:text="@string/saySomething"
        android:textAllCaps="false"
        android:textSize="40sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toTopOf="@id/one_button_reset"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/four_text"
        app:layout_constraintVertical_bias="0.148" />

    <TextView
        android:id="@+id/textView_ujep_url"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="ujep.cz"
        android:textSize="54sp"
        app:layout_constraintBottom_toTopOf="@+id/imageView_ujep"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/four_say" />

    <ImageView
        android:id="@+id/imageView_ujep"
        android:layout_width="422dp"
        android:layout_height="136dp"
        app:layout_constraintBottom_toTopOf="@+id/one_button_reset"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/textView_ujep_url"
        app:srcCompat="@drawable/logo_ujep" />

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/one_button_reset"
        android:layout_width="500dp"
        android:layout_height="200dp"
        android:layout_margin="10dp"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:text="@string/reset"
        android:textAllCaps="false"
        android:textSize="30sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>